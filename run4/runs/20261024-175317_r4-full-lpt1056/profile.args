# run4 R4-full-lpt1056: R4-full plus --long-prefill-token-threshold 1056 (two 528-token attention blocks).
# A prompt longer than 1056 tokens prefills at most 1056 tokens per step while other requests are
# eligible, so short prompts are scheduled the step they arrive instead of queueing behind it.
CMKL/MANGO1.5-Qwen3.5-9B-AWQ-W4A16-mtp
--host 0.0.0.0
--port 8000
--served-model-name mango1.5-awq-w4a16
--trust-remote-code
--gpu-memory-utilization 0.90
--max-model-len 40960
--enable-auto-tool-choice
--tool-call-parser qwen3_coder
--reasoning-parser qwen3
--speculative-config {"method":"mtp","num_speculative_tokens":1}
--enable-prefix-caching
--mamba-cache-mode align
--long-prefill-token-threshold 1056
