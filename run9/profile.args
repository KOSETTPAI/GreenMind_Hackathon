# V5. Parent: run8. Single change: --long-prefill-token-threshold 4096.
# The plan also names --max-num-partial-prefills and --max-long-partial-prefills.
# Those two flags are not in vLLM 0.32.1rc1 (the image on gm17); flag-check would reject them.
# Chunked prefill is already on by default in that image, which is what this threshold needs.
# Keep every other line identical to the kept run8 profile.
CMKL/MANGO1.5-Qwen3.5-9B-AWQ-W4A16-mtp
--host 0.0.0.0
--port 8000
--served-model-name mango1.5-awq-w4a16
--trust-remote-code
--gpu-memory-utilization 0.90
--max-model-len 40960
--enable-auto-tool-choice
--tool-call-parser qwen3_coder
--reasoning-parser qwen3
--max-num-batched-tokens 8192
--long-prefill-token-threshold 4096
