# final-run8: budget 4096 + FlashInfer + Hybrid Prefix Caching (align) + mem 0.92 + 300W
# Weights: AWQ W4A16. Autoregressive decode, MTP draft off.
# Context: 40960 to support 32K prompts + 8192 output tokens.
CMKL/MANGO1.5-Qwen3.5-9B-AWQ-W4A16-mtp
--host 0.0.0.0
--port 8000
--served-model-name mango1.5-awq-w4a16
--trust-remote-code
--gpu-memory-utilization 0.92
--max-model-len 40960
--max-num-batched-tokens 4096
--attention-backend FLASHINFER
--enable-prefix-caching
--mamba-cache-mode align
--enable-auto-tool-choice
--tool-call-parser qwen3_coder
--reasoning-parser qwen3
